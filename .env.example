# === RPC 节点 ===
# BSC 测试网 RPC（默认使用公共节点，可替换为自己的）
RPC_URL=https://bsc-testnet-rpc.publicnode.com
# BSC 主网 RPC
MAINNET_RPC_URL=https://bsc-dataseed.binance.org

# === 部署者私钥 ===
# 警告：不要把 .env 提交到 Git！.gitignore 已排除
DEPLOYER_PRIVATE_KEY=你的私钥在这里

# === BscScan API Key（用于合约验证）===
BSCSCAN_API_KEY=你的BscScan API Key

# === 合约部署参数（可选，不填使用默认值）===
# 国库地址：收税的 BNB 会转到这里。不填默认使用部署者地址
TREASURY_ADDRESS=0x...

# 买入税率（bps，100=1%，最高1000=10%）。默认 300（3%）
BUY_TAX_BPS=300

# 卖出税率（bps，100=1%，最高1000=10%）。默认 500（5%）
SELL_TAX_BPS=500

# === 验证合约时使用 ===
# 部署后把合约地址填这里，运行 verify 命令
CONTRACT_ADDRESS=0x...
